---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPartnersPage } from '../lib/sanity-queries';
import { urlFor } from '../utils/sanity';
const pageContent = await getPartnersPage();
const { partners } = pageContent;
---

<BaseLayout
  title="Partners &amp; sponsoren — Lustrum Albertus Magnus XXVI"
  description="Maak kennis met de partners en sponsoren van Lustrum Albertus Magnus XXVI, waaronder Heineken, Stëlz, 2Join en Webwavers."
  path="/partners"
>
  <Fragment slot="head">
    <style>
      .partner-link { transition: background 0.2s ease; }
      .partner-link:hover { background: #FFFFFF; color: #14245C; }
    </style>
  </Fragment>

  <div id="top" style="position: relative; background: #4557A4; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh;">
    <Header />
    <main>

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(150px, 16vw, 200px) 6vw clamp(50px, 6vw, 80px);">
      <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: #BDEEF2; margin-bottom: 14px;">{pageContent.eyebrow}</div>
      <h1 style="margin: 0 0 18px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(38px, 6vw, 84px); line-height: 1.02; letter-spacing: -0.02em; color: #BFF7F7;">{pageContent.title}</h1>
      <p style="margin: 0; max-width: 620px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: #DCEAFF;">{pageContent.description}</p>
    </section>

    <section style="max-width: 1240px; margin: 0 auto; padding: 0 6vw clamp(80px, 9vw, 130px);">
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px;">
        {partners.map((p, i) => (
          <div style="display: flex; flex-direction: column; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); overflow: hidden;">
            <div style="background: #FFFFFF; padding: 28px; display: flex; align-items: center; justify-content: center; height: 120px;">
              <img src={urlFor(p.src).width(400).auto('format').url()} srcset={`${urlFor(p.src).width(280).auto('format').url()} 280w, ${urlFor(p.src).width(400).auto('format').url()} 400w`} sizes="(max-width: 600px) 60vw, 200px" alt={`${p.name} — partner van Lustrum Albertus Magnus XXVI`} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" style="width: 100%; height: 100%; object-fit: contain;" />
            </div>
            <div style="flex: 1; display: flex; flex-direction: column; padding: 18px 20px 22px;">
              <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 18px; color: #FFFFFF; margin-bottom: 6px;">{p.name}</div>
              <div style="font-size: 14px; line-height: 1.55; color: #DCEAFF; margin-bottom: 18px;">{p.desc}</div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="partner-link" aria-label={`Bezoek de website van ${p.name}`} style="align-self: flex-start; margin-top: auto; display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; background: #BFF7F7; color: #14245C; font-size: 14px; font-weight: 600; text-decoration: none;">
                  Bezoek website <i class="ph ph-arrow-up-right"></i>
                </a>
              )}
            </div>
          </div>
        ))}
        <a href="/contact" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; border-radius: 16px; background: rgba(255,255,255,0.04); border: 1px dashed rgba(255,255,255,0.3); padding: 40px 24px; text-decoration: none; min-height: 214px;">
          <i class="ph ph-handshake" style="font-size: 30px; color: #BFF7F7;"></i>
          <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 18px; color: #FFFFFF;">Sponsor worden?</div>
          <div style="font-size: 14px; color: #DCEAFF;">Neem contact op</div>
        </a>
      </div>
    </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
