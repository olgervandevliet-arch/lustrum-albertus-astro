---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Pagina niet gevonden — Lustrum Albertus Magnus XXVI"
  description="Deze pagina bestaat niet (meer). Ga terug naar de homepage van Lustrum Albertus Magnus XXVI voor de countdown, spaarpakketten en het laatste nieuws."
  path="/404"
  noindex={true}
  breadcrumbLabel={false}
>
  <div id="top" style="position: relative; background: linear-gradient(180deg, #3B4C99 0%, #4557A4 55%, #4557A4 100%); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column;">
    <Header />
    <section style="max-width: 1240px; margin: 0 auto; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 160px 6vw 100px;">
      <i class="ph ph-compass" style="font-size: 40px; color: #BFF7F7; margin-bottom: 22px;"></i>
      <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: #9FD8E0; margin-bottom: 16px;">Foutcode 404</div>
      <h1 style="margin: 0 0 18px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(40px, 7vw, 96px); line-height: 1; letter-spacing: -0.02em; color: #BFF7F7;">Pagina niet gevonden</h1>
      <p style="margin: 0 0 30px; max-width: 520px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: #DCEAFF;">Deze pagina bestaat niet (meer). Ga terug naar de homepage van Lustrum Albertus Magnus XXVI.</p>
      <a href="/" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 26px; border-radius: 999px; background: #BFF7F7; color: #24356F; text-decoration: none; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 16px;">
        Terug naar home <i class="ph ph-arrow-right"></i>
      </a>
    </section>
    <Footer />
  </div>
</BaseLayout>
