---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CountdownFlap from '../components/CountdownFlap.astro';
import homeContent from '../data/pages/home.json';

const TARGET_DATE = homeContent.countdownTargetDate;
const diff = Math.max(0, Date.parse(TARGET_DATE) - Date.now());
const total = Math.floor(diff / 1000);
const pad = (n: number, len: number) => String(n).padStart(len, '0');
const d = pad(Math.min(999, Math.floor(total / 86400)), 3);
const h = pad(Math.floor(total / 3600) % 24, 2);
const m = pad(Math.floor(total / 60) % 60, 2);
const s = pad(total % 60, 2);

const videos = homeContent.videos;

const letters = [
  { id: 'S', left: '12.6vw', top: '18.6vh', size: '35vw', dx: '0.15', rot: '-9', speed: '1.2', sway: '-50' },
  { id: 'R', left: '46vw', top: '30.8vh', size: '35vw', dx: '1', rot: '-4', speed: '1.35', sway: '-45' },
  { id: 'M', left: '72vw', top: '20vh', size: '37vw', dx: '1.3', rot: '-5', speed: '1.1', sway: '-55' },
  { id: 'U1', left: '3.6vw', top: '56.2vh', size: '34vw', dx: '-0.9', rot: '5', speed: '0.62', sway: '45', label: 'U' },
  { id: 'T', left: '28.7vw', top: '51.1vh', size: '32vw', dx: '-0.1', rot: '7', speed: '0.78', sway: '55' },
  { id: 'U2', left: '61.3vw', top: '52.1vh', size: '33vw', dx: '1.1', rot: '8', speed: '0.68', sway: '50', label: 'U' },
  { id: 'L', left: '-3.9vw', top: '18vh', size: '36vw', dx: '-1.2', rot: '-6', speed: '1.45', sway: '-60' },
];
---

<BaseLayout
  title="Lustrum Albertus Magnus XXVI — Sinds 1896"
  description="Lustrum Albertus Magnus XXVI: het 26e lustrum van studentenvereniging Albertus Magnus, augustus 2027. Countdown, spaarpakketten en het laatste nieuws."
  path="/"
  breadcrumbLabel={false}
  structuredData={[
    {
      '@type': 'Event',
      name: 'Lustrum Albertus Magnus XXVI',
      description:
        'Het 26e lustrum van studentenvereniging Albertus Magnus: een week vol feesten, activiteiten en tradities.',
      startDate: `${TARGET_DATE}+02:00`,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Locatie volgt binnenkort',
        address: { '@type': 'PostalAddress', addressCountry: 'NL' },
      },
      organizer: { '@id': new URL('/', Astro.site).toString() + '#organization' },
      image: [new URL('/uploads/Header.jpg', Astro.site).toString()],
      url: new URL('/', Astro.site).toString(),
    },
  ]}
>
  <Fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js" is:inline></script>
    <style>
      [data-title-break] { display: inline-block; width: 0.32em; }
      @media (max-width: 980px) {
        [data-title-break] { display: block !important; }
        [data-hero-title] { font-size: clamp(30px, 7.5vw, 44px) !important; }
        [data-flap-tile] { width: clamp(24px, 5.8vw, 60px) !important; height: clamp(38px, 9.5vw, 96px) !important; font-size: clamp(18px, 4.8vw, 50px) !important; }
        [data-counter] { width: 96vw !important; }
        [data-countdown-grid] { gap: clamp(3px, 0.7vw, 14px) !important; }
        [data-cd-group] { gap: 6px !important; }
        [data-letter="S"] { font-size: 66vw !important; left: -6vw !important; top: 8vh !important; }
        [data-letter="M"] { font-size: 58vw !important; left: 10vw !important; top: 6vh !important; }
        [data-letter="R"] { font-size: 62vw !important; left: 46vw !important; top: 10vh !important; }
        [data-letter="U1"] { font-size: 58vw !important; left: -4vw !important; top: 42vh !important; }
        [data-letter="T"] { font-size: 52vw !important; left: 40vw !important; top: 44vh !important; }
        [data-letter="U2"] { font-size: 50vw !important; left: 30vw !important; top: 46vh !important; }
        [data-letter="L"] { font-size: 64vw !important; left: -8vw !important; top: 74vh !important; }
        [data-counter-glass] {
          display: block;
          border-radius: 28px;
          background: linear-gradient(180deg, rgba(20,30,70,0.42), rgba(20,30,70,0.28));
          border: 1px solid rgba(255,255,255,0.16);
          backdrop-filter: blur(20px) saturate(140%);
          -webkit-backdrop-filter: blur(20px) saturate(140%);
          box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
          padding: 18px 10px;
        }
      }
    </style>
  </Fragment>

  <div id="top" style="position: relative; background: #4557A4; font-family: 'Inter', system-ui, sans-serif;">
    <div data-preloader style="position: fixed; inset: 0; z-index: 200; background: #4557A4; display: flex; align-items: center; justify-content: center; overflow: hidden;">
      <div data-preloader-text style="position: absolute; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.6vw, 54px); color: #BFF7F7; overflow: hidden;">Albertus Magnus</div>
      <div data-preloader-text style="position: absolute; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.6vw, 54px); color: #BFF7F7; overflow: hidden; opacity: 0;">Sinds 1896</div>
      <div data-preloader-text style="position: absolute; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.6vw, 54px); color: #BFF7F7; overflow: hidden; opacity: 0;">XXVI Lustrum</div>
    </div>

    <Header showAnnouncement={true} />

    <section data-hero-wrap data-target-date={TARGET_DATE} style="position: relative; height: 300vh;">
      <div style="position: sticky; top: 0; height: 100vh; overflow: hidden; background: #BFF7F7;">
        <div data-gradient style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: hidden; background: linear-gradient(180deg, #3B4C99 0%, #4C5FA8 30%, #6B87C0 55%, #9CC4DE 78%, #BFF7F7 100%); will-change: transform;">
          <div style="position: absolute; inset: 0;">
            {letters.map((l) => (
              <span
                data-letter={l.id}
                data-dx={l.dx}
                data-rot={l.rot}
                data-speed={l.speed}
                data-sway={l.sway}
                style={`position: absolute; font-family: 'Inter Tight', sans-serif; font-weight: 800; line-height: 0.74; color: #BFF7F7; will-change: transform; left: ${l.left}; top: ${l.top}; font-size: ${l.size}; transform: translateY(-160vh) rotate(${l.rot}deg)`}
              >{l.label ?? l.id}</span>
            ))}
          </div>
        </div>

        <div data-counter style="position: absolute; left: 50%; bottom: 14vh; transform: translate(-50%, 0); opacity: 1; width: min(1160px, 90vw); will-change: transform;">
          <div style="text-align: center; margin-bottom: clamp(36px, 8vw, 80px);">
            <h1 data-hero-title style="margin: 0; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.2vw, 48px); letter-spacing: 0.02em; color: #24356F; overflow: hidden;"><span data-title-word>Lustrum</span><span data-title-break> </span><span data-title-word>Albertus</span><span data-title-break> </span><span data-title-word>XXVI</span></h1>
          </div>
          <div data-counter-glass>
            <div data-countdown-grid style="display: flex; align-items: flex-start; justify-content: center; flex-wrap: wrap; row-gap: 14px; gap: clamp(4px, 1vw, 14px); position: relative">
              <div data-cd-group="days" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="display: flex; justify-content: center; gap: clamp(5px, 0.7vw, 10px);">
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="d0" value={d[0]} /></div>
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="d1" value={d[1]} /></div>
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="d2" value={d[2]} /></div>
                </div>
                <div style="font-size: clamp(12px, 1.05vw, 16px); font-weight: 500; color: #2C3C86;">Dagen</div>
              </div>
              <div style="height: clamp(54px, 9.4vw, 146px); display: flex; flex-direction: column; justify-content: center; gap: clamp(10px, 1.4vw, 22px); font-size: 0; color: #3B4C99;"><span style="display: block; width: clamp(5px, 0.5vw, 8px); height: clamp(5px, 0.5vw, 8px); border-radius: 50%; background: #3B4C99;"></span><span style="display: block; width: clamp(5px, 0.5vw, 8px); height: clamp(5px, 0.5vw, 8px); border-radius: 50%; background: #3B4C99;"></span></div>
              <div data-cd-group="hours" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="display: flex; justify-content: center; gap: clamp(5px, 0.7vw, 10px);">
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="h0" value={h[0]} /></div>
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="h1" value={h[1]} /></div>
                </div>
                <div style="font-size: clamp(12px, 1.05vw, 16px); font-weight: 500; color: #2C3C86;">Uren</div>
              </div>
              <div style="height: clamp(54px, 9.4vw, 146px); display: flex; flex-direction: column; justify-content: center; gap: clamp(10px, 1.4vw, 22px); font-size: 0; color: #3B4C99;"><span style="display: block; width: clamp(5px, 0.5vw, 8px); height: clamp(5px, 0.5vw, 8px); border-radius: 50%; background: #3B4C99;"></span><span style="display: block; width: clamp(5px, 0.5vw, 8px); height: clamp(5px, 0.5vw, 8px); border-radius: 50%; background: #3B4C99;"></span></div>
              <div data-cd-group="minutes" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="display: flex; justify-content: center; gap: clamp(5px, 0.7vw, 10px);">
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="m0" value={m[0]} /></div>
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="m1" value={m[1]} /></div>
                </div>
                <div style="font-size: clamp(12px, 1.05vw, 16px); font-weight: 500; color: #2C3C86;">Minuten</div>
              </div>
              <div style="height: clamp(54px, 9.4vw, 146px); display: flex; flex-direction: column; justify-content: center; gap: clamp(10px, 1.4vw, 22px); font-size: 0; color: #3B4C99;"><span style="display: block; width: clamp(5px, 0.5vw, 8px); height: clamp(5px, 0.5vw, 8px); border-radius: 50%; background: #3B4C99;"></span><span style="display: block; width: clamp(5px, 0.5vw, 8px); height: clamp(5px, 0.5vw, 8px); border-radius: 50%; background: #3B4C99;"></span></div>
              <div data-cd-group="seconds" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="display: flex; justify-content: center; gap: clamp(5px, 0.7vw, 10px);">
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="s0" value={s[0]} /></div>
                  <div data-flap-tile style="width: clamp(34px, 5.6vw, 88px); height: clamp(54px, 9.4vw, 146px); font-family: 'Inter Tight', sans-serif; font-size: clamp(26px, 4.8vw, 78px);"><CountdownFlap id="s1" value={s[1]} /></div>
                </div>
                <div style="font-size: clamp(12px, 1.05vw, 16px); font-weight: 500; color: #2C3C86;">Seconden</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="position: relative; background: #4557A4; padding: clamp(70px, 9vw, 130px) 0 clamp(60px, 7vw, 110px);">
      <div style="max-width: 1240px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 6vw; margin-bottom: clamp(34px, 4vw, 60px);">
        <h2 data-title-reveal style="margin: 0; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(44px, 7vw, 104px); line-height: 1; letter-spacing: -0.025em; color: #BFF7F7;">Laatste video's</h2>
        <div style="display: flex; gap: 10px; flex: 0 0 auto;">
          <button type="button" aria-label="Vorige" data-video-prev style="display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.3); background: transparent; color: #BFF7F7; cursor: pointer; font-size: 20px;">
            <i class="ph ph-arrow-left"></i>
          </button>
          <button type="button" aria-label="Volgende" data-video-next style="display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.3); background: transparent; color: #BFF7F7; cursor: pointer; font-size: 20px;">
            <i class="ph ph-arrow-right"></i>
          </button>
        </div>
      </div>
      <div data-video-track style="display: flex; gap: clamp(16px, 1.6vw, 26px); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: max(6vw, calc((100vw - 1240px) / 2)); scrollbar-width: none; padding: 0 6vw 24px; padding-left: max(6vw, calc((100vw - 1240px) / 2));">
        {videos.map((v) => (
          v.available ? (
            <button type="button" data-video-open={v.embed} style="text-align: left; cursor: pointer; scroll-snap-align: start; flex: 0 0 auto; width: clamp(280px, 26vw, 400px); padding: 12px 12px 6px; border-radius: 14px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.14);">
              <div style="position: relative; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background-color: #6E86C4;">
                <img src={v.thumbnail} alt={`Video: ${v.title} — Lustrum Albertus Magnus XXVI`} loading="lazy" decoding="async" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
                <div style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 54px; height: 54px; border-radius: 50%; background: #BFF7F7; display: grid; place-items: center; box-shadow: 0 14px 30px -18px rgba(10,20,50,0.7);">
                  <span style="display: block; width: 0; height: 0; margin-left: 4px; border-left: 15px solid #3B4C99; border-top: 10px solid transparent; border-bottom: 10px solid transparent;"></span>
                </div>
              </div>
              <div style="padding: 12px 2px 10px; font-family: 'Inter Tight', sans-serif; font-size: clamp(17px, 1.4vw, 21px); font-weight: 600; color: #E8F9FF;">{v.title}</div>
            </button>
          ) : (
            <article style="scroll-snap-align: start; flex: 0 0 auto; width: clamp(280px, 26vw, 400px); padding: 12px 12px 6px; border-radius: 14px; background: rgba(255,255,255,0.06); border: 1px dashed rgba(255,255,255,0.2);">
              <div style="position: relative; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center;">
                <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: #BFF7F7; background: rgba(191,247,247,0.12); padding: 6px 12px; border-radius: 999px;">Coming soon</span>
              </div>
              <div style="padding: 12px 2px 10px; font-family: 'Inter Tight', sans-serif; font-size: clamp(17px, 1.4vw, 21px); font-weight: 600; color: rgba(232,249,255,0.4);">Binnenkort beschikbaar</div>
            </article>
          )
        ))}
      </div>
    </section>

    <div data-video-modal style="display: none; position: fixed; inset: 0; z-index: 300; background: rgba(11,15,35,0.88); align-items: center; justify-content: center; padding: 5vw;">
      <div style="position: relative; width: min(1100px, 92vw);">
        <button type="button" aria-label="Sluiten" data-video-close style="position: absolute; right: 0; bottom: 100%; margin-bottom: 12px; width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.08); color: #FFFFFF; font-size: 18px; display: grid; place-items: center; cursor: pointer;">
          <i class="ph ph-x"></i>
        </button>
        <div style="position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #000000; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6);">
          <iframe data-video-frame src="" title="Video" style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      </div>
    </div>

    <Footer />
  </div>

  <script src="/scripts/home.js" is:inline></script>
</BaseLayout>
