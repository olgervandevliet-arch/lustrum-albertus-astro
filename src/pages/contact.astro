---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings, getContactPage } from '../lib/sanity-queries';
import { urlFor } from '../utils/sanity';
const site = await getSiteSettings();
const pageContent = await getContactPage();
const { board, emailContacts, groupPhoto } = pageContent;

// Board portraits are framed tight on the face. Without a crop set in the
// Studio, cut that framing from the full-res original (rather than zooming a
// small image up with CSS, which made them blurry).
function boardPhotoSrc(photo: any, dims: { width: number; height: number } | null, w = 640) {
  let img = urlFor(photo);
  if (!photo?.crop && dims) {
    const size = Math.round(dims.width * 0.625);
    img = img.rect(Math.round(dims.width * 0.1875), Math.round(dims.height * 0.0675), size, size);
  }
  return img.width(w).height(w).fit('crop').auto('format').quality(80).url();
}
---

<BaseLayout
  title="Contact — Lustrum Albertus Magnus XXVI"
  description="Neem contact op met het lustrumcomité van Lustrum Albertus Magnus XXVI voor vragen over het lustrum, sponsoring of de commissies."
  path="/contact"
>
  <Fragment slot="head">
    <style>
      [data-board-grid] { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
      @media (min-width: 700px) {
        [data-board-grid] { grid-template-columns: repeat(4, 1fr); }
      }
      [data-contact-layout] { grid-template-columns: 1fr; }
      @media (min-width: 900px) {
        [data-contact-layout] { grid-template-columns: 1.1fr 1fr; }
        [data-contact-photo] { margin-top: clamp(40px, 4vw, 60px); }
      }
      [data-contact-toggle]:hover span { color: #BFF7F7; }
    </style>
  </Fragment>

  <div id="top" style="position: relative; background: #4557A4; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh;">
    <Header />
    <main>

    <section data-contact-layout style="max-width: 1240px; margin: 0 auto; padding: clamp(150px, 16vw, 200px) 6vw clamp(50px, 6vw, 80px); display: grid; gap: clamp(32px, 4vw, 56px); align-items: start;">
      <div>
        <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: #BDEEF2; margin-bottom: 14px;">{pageContent.eyebrow}</div>
        <h1 style="margin: 0 0 18px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(38px, 5.4vw, 76px); line-height: 1.02; letter-spacing: -0.02em; color: #BFF7F7;">{pageContent.title}</h1>
        <p style="margin: 0 0 32px; max-width: 560px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: #DCEAFF;">{pageContent.description}</p>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {emailContacts.map((c) => (
            <div data-contact-item style="border-radius: 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); overflow: hidden;">
              <button type="button" data-contact-toggle aria-expanded="false" style="width: 100%; display: flex; align-items: center; gap: 14px; padding: 18px 20px; background: transparent; border: 0; cursor: pointer; text-align: left; color: #FFFFFF; font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: clamp(15px, 1.4vw, 17px);">
                <i class="ph ph-envelope-simple" style="flex: 0 0 auto; font-size: 22px; color: #BFF7F7;"></i>
                <span style="flex: 1;">{c.label}</span>
                <i data-contact-icon class="ph ph-plus" style="flex: 0 0 auto; font-size: 18px; color: #BFF7F7; transition: transform 0.25s ease;"></i>
              </button>
              <div data-contact-panel hidden style="padding: 0 20px 18px 56px; font-size: 15px; line-height: 1.6;">
                <div style="color: #BDEEF2;">{c.contactName}</div>
                <a href={`mailto:${c.email}`} style="color: #FFFFFF; text-decoration: underline; text-underline-offset: 3px; word-break: break-all;">{c.email}</a>
              </div>
            </div>
          ))}
          <div data-contact-item style="border-radius: 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); overflow: hidden;">
            <button type="button" data-contact-toggle aria-expanded="false" style="width: 100%; display: flex; align-items: center; gap: 14px; padding: 18px 20px; background: transparent; border: 0; cursor: pointer; text-align: left; color: #FFFFFF; font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: clamp(15px, 1.4vw, 17px);">
              <i class="ph ph-instagram-logo" style="flex: 0 0 auto; font-size: 22px; color: #BFF7F7;"></i>
              <span style="flex: 1;">Instagram</span>
              <i data-contact-icon class="ph ph-plus" style="flex: 0 0 auto; font-size: 18px; color: #BFF7F7; transition: transform 0.25s ease;"></i>
            </button>
            <div data-contact-panel hidden style="padding: 0 20px 18px 56px; font-size: 15px; line-height: 1.6;">
              <a href={site.instagramUrl} target="_blank" rel="noopener" style="color: #FFFFFF; text-decoration: underline; text-underline-offset: 3px;">{site.instagramHandle}</a>
            </div>
          </div>
        </div>
      </div>
      {groupPhoto?.asset && (
        <div data-contact-photo style="border-radius: 16px; overflow: hidden; aspect-ratio: 1 / 1; background: rgba(103,123,192,0.16);">
          <img src={urlFor(groupPhoto).width(900).height(900).fit('crop').auto('format').quality(80).url()} srcset={[480, 720, 900, 1200].map((w) => `${urlFor(groupPhoto).width(w).height(w).fit('crop').auto('format').quality(80).url()} ${w}w`).join(', ')} sizes="(max-width: 899px) 88vw, 560px" width="900" height="900" alt="Het lustrumcomité van Lustrum Albertus Magnus XXVI" fetchpriority="high" decoding="async" style="display: block; width: 100%; height: 100%; object-fit: cover;" />
        </div>
      )}
    </section>

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 5vw, 70px) 6vw;">
      <h2 style="margin: 0 0 28px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.2vw, 42px); color: #BFF7F7;">Lustrumcomité</h2>
      <div data-board-grid style="display: grid; gap: 22px;">
        {board.map((p) => (
          <div style="padding: 12px 12px 14px; border-radius: 14px; background: rgba(103,123,192,0.16); border: 1px solid rgba(103,123,192,0.4);">
            <div style="position: relative; width: 100%; aspect-ratio: 1; margin-bottom: 10px; border-radius: 8px; overflow: hidden;">
              <img src={boardPhotoSrc(p.photo, p.photoDims)} srcset={[320, 480, 640, 900].map((w) => `${boardPhotoSrc(p.photo, p.photoDims, w)} ${w}w`).join(', ')} sizes="(max-width: 699px) 45vw, 270px" width="640" height="640" alt={`${p.name}, ${p.role} van het lustrumcomité`} loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              {p.email && (
                <a href={`mailto:${p.email}`} aria-label={`Mail ${p.name} (${p.email})`} title={p.email} style="position: absolute; right: 8px; bottom: 8px; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: #BFF7F7; color: #14245C; text-decoration: none; font-size: 15px;">
                  <i class="ph ph-envelope-simple"></i>
                </a>
              )}
            </div>
            <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; color: #FFFFFF; font-size: 16px;">{p.name}</div>
            <div style="font-size: 14px; color: #BDEEF2;">{p.role}</div>
          </div>
        ))}
      </div>
    </section>

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 4vw, 50px) 6vw clamp(80px, 9vw, 130px);">
      <h2 style="margin: 0 0 10px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.2vw, 42px); color: #BFF7F7;">Commissies</h2>
      <p style="margin: 0 0 20px; max-width: 620px; font-size: 16px; line-height: 1.6; color: #DCEAFF;">De parttime commissies die het lustrum mogelijk maken.</p>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px; padding: 18px 22px; margin-bottom: 30px; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); max-width: 720px;">
        <p style="margin: 0; flex: 1 1 260px; font-size: 15px; line-height: 1.55; color: #DCEAFF;">Wil je je kennisgeving van interesse (KVI) inleveren voor een commissie? Dat kan via de Albertus App.</p>
        <div style="display: flex; gap: 10px; flex: 0 0 auto;">
          <a href="https://apps.apple.com/nl/app/albertus-magnus/id1591068864" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px; background: #24356F; color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600;">
            <i class="ph ph-apple-logo"></i> App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=nl.albertus.app&hl=nl&pli=1" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px; background: #24356F; color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600;">
            <i class="ph ph-google-play-logo"></i> Google Play
          </a>
        </div>
      </div>
    </section>
    </main>

    <Footer />
  </div>

</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact-item]').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-contact-toggle]');
    const panel = item.querySelector<HTMLElement>('[data-contact-panel]');
    const icon = item.querySelector<HTMLElement>('[data-contact-icon]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      if (panel) panel.hidden = !open;
      if (icon) icon.style.transform = open ? 'rotate(45deg)' : 'rotate(0deg)';
    });
  });
</script>
