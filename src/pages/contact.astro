---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings, getContactPage } from '../lib/sanity-queries';
import { urlFor } from '../utils/sanity';
const site = await getSiteSettings();
const pageContent = await getContactPage();
const { board, emailContacts } = pageContent;

// Board portraits are framed tight on the face. Without a crop set in the
// Studio, cut that framing from the full-res original (rather than zooming a
// small image up with CSS, which made them blurry).
function boardPhotoSrc(photo: any, dims: { width: number; height: number } | null) {
  let img = urlFor(photo);
  if (!photo?.crop && dims) {
    const size = Math.round(dims.width * 0.625);
    img = img.rect(Math.round(dims.width * 0.1875), Math.round(dims.height * 0.0675), size, size);
  }
  return img.width(900).height(900).fit('crop').auto('format').quality(85).url();
}
---

<BaseLayout
  title="Contact — Lustrum Albertus Magnus XXVI"
  description="Neem contact op met het lustrumbestuur van Lustrum Albertus Magnus XXVI voor vragen over het lustrum, sponsoring of de commissies."
  path="/contact"
>
  <Fragment slot="head">
    <style>
      [data-board-grid] { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
      @media (min-width: 700px) {
        [data-board-grid] { grid-template-columns: repeat(4, 1fr); }
      }
      [data-email-grid] { grid-template-columns: 1fr; }
      @media (min-width: 560px) {
        [data-email-grid] { grid-template-columns: repeat(2, 1fr); }
      }
    </style>
  </Fragment>

  <div id="top" style="position: relative; background: #4557A4; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh;">
    <Header />

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(150px, 16vw, 200px) 6vw clamp(50px, 6vw, 80px);">
      <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: #9FD8E0; margin-bottom: 14px;">{pageContent.eyebrow}</div>
      <h1 style="margin: 0 0 18px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(38px, 6vw, 84px); line-height: 1.02; letter-spacing: -0.02em; color: #BFF7F7;">{pageContent.title}</h1>
      <p style="margin: 0; max-width: 620px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: #DCEAFF;">{pageContent.description}</p>
    </section>

    <section style="max-width: 1240px; margin: 0 auto; padding: 0 6vw clamp(50px, 6vw, 80px);">
      <div data-email-grid style="display: grid; gap: 18px;">
        {emailContacts.map((c) => (
          <a href={`mailto:${c.email}`} style="display: flex; align-items: center; gap: 16px; padding: 22px; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); text-decoration: none;">
            <i class="ph ph-envelope-simple" style="font-size: 26px; color: #BFF7F7; flex: 0 0 auto;"></i>
            <div style="min-width: 0;">
              <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; color: #FFFFFF; margin-bottom: 2px;">{c.label}</div>
              <div style="font-size: 13px; color: #9FD8E0; margin-bottom: 2px;">{c.contactName}</div>
              <div style="font-size: 14px; color: #DCEAFF; word-break: break-all;">{c.email}</div>
            </div>
          </a>
        ))}
        <a href={site.instagramUrl} target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 16px; padding: 22px; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); text-decoration: none;">
          <i class="ph ph-instagram-logo" style="font-size: 26px; color: #BFF7F7; flex: 0 0 auto;"></i>
          <div>
            <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; color: #FFFFFF; margin-bottom: 2px;">Instagram</div>
            <div style="font-size: 15px; color: #DCEAFF;">{site.instagramHandle}</div>
          </div>
        </a>
      </div>
    </section>

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 5vw, 70px) 6vw;">
      <h2 style="margin: 0 0 28px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.2vw, 42px); color: #BFF7F7;">Lustrumbestuur</h2>
      <div data-board-grid style="display: grid; gap: 22px;">
        {board.map((p) => (
          <div style="padding: 12px 12px 14px; border-radius: 14px; background: rgba(103,123,192,0.16); border: 1px solid rgba(103,123,192,0.4);">
            <div style="position: relative; width: 100%; aspect-ratio: 1; margin-bottom: 10px; border-radius: 8px; overflow: hidden;">
              <img src={boardPhotoSrc(p.photo, p.photoDims)} alt={`${p.name}, ${p.role} van het lustrumbestuur`} loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              {p.email && (
                <a href={`mailto:${p.email}`} aria-label={`Mail ${p.name} (${p.email})`} title={p.email} style="position: absolute; right: 8px; bottom: 8px; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: #BFF7F7; color: #14245C; text-decoration: none; font-size: 15px;">
                  <i class="ph ph-envelope-simple"></i>
                </a>
              )}
            </div>
            <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; color: #FFFFFF; font-size: 16px;">{p.name}</div>
            <div style="font-size: 14px; color: #9FD8E0;">{p.role}</div>
          </div>
        ))}
      </div>
    </section>

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 4vw, 50px) 6vw clamp(80px, 9vw, 130px);">
      <h2 style="margin: 0 0 10px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.2vw, 42px); color: #BFF7F7;">Commissies</h2>
      <p style="margin: 0 0 20px; max-width: 620px; font-size: 16px; line-height: 1.6; color: #DCEAFF;">De parttime commissies die het lustrum mogelijk maken.</p>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px; padding: 18px 22px; margin-bottom: 30px; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); max-width: 720px;">
        <p style="margin: 0; flex: 1 1 260px; font-size: 15px; line-height: 1.55; color: #DCEAFF;">Wil je je kandidaat-vrijwilligersinschrijving (KVI) inleveren voor een commissie? Dat kan via de Albertus App.</p>
        <div style="display: flex; gap: 10px; flex: 0 0 auto;">
          <a href="https://apps.apple.com/nl/app/albertus-magnus/id1591068864" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px; background: #24356F; color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600;">
            <i class="ph ph-apple-logo"></i> App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=nl.albertus.app&hl=nl&pli=1" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px; background: #24356F; color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600;">
            <i class="ph ph-google-play-logo"></i> Google Play
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </div>

</BaseLayout>
