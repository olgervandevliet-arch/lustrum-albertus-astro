---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import pageContent from '../data/pages/kleuren.json';
const { colors } = pageContent;
---

<BaseLayout
  title="Kleuren — Lustrum Albertus Magnus XXVI"
  description="De officiële kleuren van Lustrum Albertus Magnus XXVI: Violet Velvet en Serene Green, met HEX, RGB, CMYK, Pantone en RAL-codes."
  path="/kleuren"
>
  <Fragment slot="head">
    <style>
      @media (max-width: 760px) {
        [data-color-grid] { grid-template-columns: 1fr !important; }
      }
    </style>
  </Fragment>

  <div id="top" style="position: relative; background: #4557A4; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh;">
    <Header />

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(130px, 14vw, 170px) 6vw clamp(50px, 14vw, 90px); text-align: center;">
      <h1 style="margin: 0 0 18px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(38px, 6vw, 84px); line-height: 1.02; letter-spacing: -0.02em; color: #BFF7F7;">{pageContent.title}</h1>
      <p style="margin: 0 auto; max-width: 620px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.65; color: #DCEAFF;">{pageContent.description}</p>
    </section>

    <div data-color-grid style="display: grid; grid-template-columns: 1fr 1fr;">
      {colors.map((c) => (
        <div style={`background: ${c.hex}; min-height: 60vh; padding: clamp(40px, 6vw, 64px) clamp(28px, 5vw, 56px); display: flex; flex-direction: column;`}>
          <div style={`font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(24px, 2.6vw, 32px); color: ${c.onHex};`}>{c.name}</div>
          <div style="flex: 1; min-height: 40px;"></div>
          <div style={`display: flex; flex-direction: column; gap: 7px; margin-bottom: 28px; font-size: 15px; color: ${c.onHex};`}>
            <div><span style="font-weight: 700;">HEX</span> {c.hex}</div>
            <div><span style="font-weight: 700;">RGB</span> {c.rgb}</div>
            <div><span style="font-weight: 700;">CMYK</span> {c.cmyk}</div>
            <div><span style="font-weight: 700;">Pantone</span> {c.pantone}</div>
            <div><span style="font-weight: 700;">RAL</span> {c.ral}</div>
          </div>
          <a href={c.url} target="_blank" rel="noopener" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 999px; background: #FFFFFF; color: #12131A; text-decoration: none; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 15px;">
            Bekijk verf bij Verfplaza <i class="ph ph-arrow-up-right"></i>
          </a>
        </div>
      ))}
    </div>

    <Footer />
  </div>
</BaseLayout>
