---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getKleurenPage } from '../lib/sanity-queries';
const pageContent = await getKleurenPage();
const { colors } = pageContent;
---

<BaseLayout
  title="Kleuren — Lustrum Albertus Magnus XXVI"
  description="De officiële kleuren van Lustrum Albertus Magnus XXVI: Paars en Aquamarijn, met HEX, RGB, CMYK, Pantone en RAL-codes."
  path="/kleuren"
>
  <Fragment slot="head">
    <style>
      @media (max-width: 760px) {
        [data-color-grid] { grid-template-columns: 1fr !important; }
      }
    </style>
  </Fragment>

  <div id="top" style="position: relative; background: #4557A4; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh;">
    <Header />
    <main>

    <section style="max-width: 1240px; margin: 0 auto; padding: clamp(130px, 14vw, 170px) 6vw clamp(50px, 14vw, 90px); text-align: center;">
      <h1 style="margin: 0 0 18px; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(38px, 6vw, 84px); line-height: 1.02; letter-spacing: -0.02em; color: #BFF7F7;">{pageContent.title}</h1>
      <p style="margin: 0 auto; max-width: 620px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.65; color: #DCEAFF;">{pageContent.description}</p>
      <a href="https://tally.so/r/yPV5rx" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; margin-top: 28px; padding: 12px 22px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #BFF7F7; text-decoration: none; font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 15px;">
        <i class="ph ph-paint-roller"></i> Bestel het verfpakket
      </a>
    </section>

    <div data-color-grid style="display: grid; grid-template-columns: 1fr 1fr;">
      {colors.map((c) => (
        <div style={`background: ${c.hex}; min-height: 60vh; padding: clamp(40px, 6vw, 64px) clamp(28px, 5vw, 56px); display: flex; flex-direction: column;`}>
          <div style={`font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(24px, 2.6vw, 32px); color: ${c.onHex};`}>{c.name}</div>
          <div style="flex: 1; min-height: 40px;"></div>
          <div style={`display: flex; flex-direction: column; gap: 7px; font-size: 15px; color: ${c.onHex};`}>
            <div><span style="font-weight: 700;">HEX</span> {c.hex}</div>
            <div><span style="font-weight: 700;">RGB</span> {c.rgb}</div>
            <div><span style="font-weight: 700;">CMYK</span> {c.cmyk}</div>
            <div><span style="font-weight: 700;">Pantone</span> {c.pantone}</div>
            <div><span style="font-weight: 700;">RAL</span> {c.ral}</div>
          </div>
        </div>
      ))}
    </div>

    <section id="verfpakket" style="max-width: 1240px; margin: 0 auto; padding: clamp(60px, 8vw, 110px) 6vw clamp(80px, 9vw, 130px);">
      <div style="max-width: 1160px; margin: 0 auto; border-radius: 20px; background: linear-gradient(180deg, rgba(255,255,255,0.1), rgba(255,255,255,0.04)); border: 1px solid rgba(255,255,255,0.16); padding: clamp(26px, 3vw, 36px) clamp(24px, 3vw, 36px); display: flex; flex-wrap: wrap; gap: 28px 48px; align-items: flex-end; justify-content: space-between;">
        <div style="flex: 1 1 520px;">
          <div style="font-family: 'Inter Tight', sans-serif; font-weight: 600; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #BDEEF2; margin-bottom: 10px;">Laatste week om te bestellen</div>
          <div style="display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 20px;">
            <h2 style="margin: 0; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: clamp(28px, 3.2vw, 40px); line-height: 1.1; color: #BFF7F7;">Verfpakket</h2>
            <div style="font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: clamp(24px, 2.4vw, 30px); color: #FFFFFF;">€120,-</div>
          </div>
          <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 28px;">
            {[
              '1× 10 liter Aquamarijn',
              '1× 10 liter Paars',
              '2× sausroller met beugel 20 cm',
              '2× texkwasten',
              '1× afdekfolie 4×5',
              '1× verfbak 5 L',
              '5× inzetbakken',
              '1× rol tape 24 mm',
            ].map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 15px; line-height: 1.5; color: #DCEAFF;">
                <i class="ph ph-check-circle" style="flex: 0 0 auto; color: #BDEEF2; font-size: 18px; margin-top: 2px;"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <a href="https://tally.so/r/yPV5rx" target="_blank" rel="noopener" style="flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; padding: 14px 26px; border-radius: 999px; background: #BFF7F7; color: #24356F; text-decoration: none; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 16px;">
          Bestel je verfpakket <i class="ph ph-arrow-right"></i>
        </a>
      </div>
    </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
