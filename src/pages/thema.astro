---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ComingSoon from '../components/ComingSoon.astro';
---

<BaseLayout
  title="Thema — Lustrum Albertus Magnus XXVI"
  description="Het thema van Lustrum Albertus Magnus XXVI wordt binnenkort bekendgemaakt. Houd deze pagina en Instagram in de gaten."
  path="/thema"
>
  <div id="top" style="position: relative; background: linear-gradient(180deg, #3B4C99 0%, #4557A4 55%, #4557A4 100%); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column;">
    <Header />
    <ComingSoon
      icon="ph ph-sparkle"
      eyebrow="Thema & Informatie"
      description="Het thema van Lustrum Albertus Magnus XXVI wordt binnenkort bekendgemaakt. Houd deze pagina en onze Instagram in de gaten."
    />
    <Footer />
  </div>
</BaseLayout>
