---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ComingSoon from '../components/ComingSoon.astro';
import pageContent from '../data/pages/thema.json';
---

<BaseLayout
  title={`${pageContent.title} — Lustrum Albertus Magnus XXVI`}
  description={pageContent.description}
  path="/thema"
>
  <div id="top" style="position: relative; background: linear-gradient(180deg, #3B4C99 0%, #4557A4 55%, #4557A4 100%); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column;">
    <Header />
    <ComingSoon
      icon={pageContent.icon}
      eyebrow={pageContent.eyebrow}
      description={pageContent.description}
    />
    <Footer />
  </div>
</BaseLayout>
