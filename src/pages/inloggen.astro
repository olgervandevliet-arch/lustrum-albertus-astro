---
// Short, memorable alias for the Sanity Studio login.
const STUDIO_URL = '/admin';
---

<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`0; url=${STUDIO_URL}`} />
  <title>Inloggen — Lustrum Albertus Magnus XXVI</title>
  <script define:vars={{ STUDIO_URL }}>window.location.replace(STUDIO_URL);</script>
</head>
<body></body>
</html>
