---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ComingSoon from '../components/ComingSoon.astro';
---

<BaseLayout
  title="Terrein — Lustrum Albertus Magnus XXVI"
  description="Meer over de locatie van de lustrumweek volgt binnenkort — plattegrond, faciliteiten en bereikbaarheid."
  path="/terrein"
>
  <div id="top" style="position: relative; background: linear-gradient(180deg, #3B4C99 0%, #4557A4 55%, #4557A4 100%); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column;">
    <Header />
    <ComingSoon
      icon="ph ph-map-pin"
      eyebrow="Terrein"
      description="Meer over de locatie van de lustrumweek volgt binnenkort — plattegrond, faciliteiten en bereikbaarheid."
    />
    <Footer />
  </div>
</BaseLayout>
