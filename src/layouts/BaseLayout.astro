---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** Extra JSON-LD nodes for this page (e.g. Event, FAQPage) — merged into the site-wide @graph. */
  structuredData?: Record<string, unknown>[];
  /** Short label for the breadcrumb trail, e.g. "Spaarpakketten". Defaults to the part of `title` before " — ". Pass `false` to omit the breadcrumb (used on the homepage). */
  breadcrumbLabel?: string | false;
  /** Set true to keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/uploads/Header.jpg',
  structuredData = [],
  breadcrumbLabel,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const siteRoot = new URL('/', Astro.site).toString();

const organizationNode = {
  '@type': 'Organization',
  '@id': siteRoot + '#organization',
  name: 'Studentenvereniging Albertus Magnus',
  url: siteRoot,
  logo: new URL('/uploads/AM-lustrum-fav.png', Astro.site).toString(),
  sameAs: ['https://www.instagram.com/lustrumalbertus/'],
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': siteRoot + '#website',
  name: 'Lustrum Albertus Magnus XXVI',
  alternateName: 'Lustrum Albertus',
  url: siteRoot,
  publisher: { '@id': siteRoot + '#organization' },
  inLanguage: 'nl-NL',
};

const resolvedBreadcrumbLabel =
  breadcrumbLabel === false ? null : breadcrumbLabel ?? title.split(' — ')[0];

const breadcrumbNode =
  resolvedBreadcrumbLabel && path !== '/'
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
          { '@type': 'ListItem', position: 2, name: resolvedBreadcrumbLabel, item: canonicalURL.toString() },
        ],
      }
    : null;

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organizationNode, websiteNode, breadcrumbNode, ...structuredData].filter(Boolean),
};
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="theme-color" content="#4557A4" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lustrum Albertus Magnus XXVI" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:locale" content="nl_NL" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="icon" type="image/png" href="/uploads/AM-lustrum-fav.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Inter+Tight:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" is:inline></script>
  <script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>
  <script src="/scripts/page-transition.js" is:inline></script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
