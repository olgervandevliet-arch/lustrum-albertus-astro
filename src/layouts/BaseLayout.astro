---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interTightFont from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import pageTransitionScript from '../../public/scripts/page-transition.js?raw';
import VercelAnalytics from '@vercel/analytics/astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** Extra JSON-LD nodes for this page (e.g. Event, FAQPage) — merged into the site-wide @graph. */
  structuredData?: Record<string, unknown>[];
  /** Short label for the breadcrumb trail, e.g. "Spaarpakketten". Defaults to the part of `title` before " — ". Pass `false` to omit the breadcrumb (used on the homepage). */
  breadcrumbLabel?: string | false;
  /** Set true to keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/uploads/og-image.jpg',
  structuredData = [],
  breadcrumbLabel,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const siteRoot = new URL('/', Astro.site).toString();

const organizationNode = {
  '@type': 'Organization',
  '@id': siteRoot + '#organization',
  name: 'Studentenvereniging Albertus Magnus',
  url: siteRoot,
  logo: new URL('/uploads/logo-512.png', Astro.site).toString(),
  sameAs: ['https://www.instagram.com/lustrumalbertus/', 'https://www.youtube.com/@lustrumalbertusmagnusxxvi'],
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': siteRoot + '#website',
  name: 'Lustrum Albertus Magnus XXVI',
  alternateName: 'Lustrum Albertus',
  url: siteRoot,
  publisher: { '@id': siteRoot + '#organization' },
  inLanguage: 'nl-NL',
};

const resolvedBreadcrumbLabel =
  breadcrumbLabel === false ? null : breadcrumbLabel ?? title.split(' — ')[0];

const breadcrumbNode =
  resolvedBreadcrumbLabel && path !== '/'
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
          { '@type': 'ListItem', position: 2, name: resolvedBreadcrumbLabel, item: canonicalURL.toString() },
        ],
      }
    : null;

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organizationNode, websiteNode, breadcrumbNode, ...structuredData].filter(Boolean),
};
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="theme-color" content="#4557A4" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lustrum Albertus Magnus XXVI" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="nl_NL" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="icon" type="image/png" href="/uploads/favicon-192.png" />

  <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="" />
  <link rel="preload" href={interTightFont} as="font" type="font/woff2" crossorigin="" />
  <link rel="preload" href="/vendor/phosphor/Phosphor.woff2" as="font" type="font/woff2" crossorigin="" />
  <link rel="stylesheet" href="/vendor/phosphor/phosphor.css" />
  <script src="/vendor/gsap/gsap.min.js" is:inline defer></script>
  <!-- inlined: it must run before the first paint (curtain colour), without an extra blocking request -->
  <script is:inline set:html={pageTransitionScript} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

  <slot name="head" />
</head>
<body>
  <slot />
  <Analytics />
  <VercelAnalytics />
</body>
</html>
